{{!-- Os botões de um desafio de acesso na janela de ações: dentro do ponto a que
      pertence, ou na seção de desafios soltos. Contexto = o desafio. --}}
<div class="op2-acoes__alvo-topo op2-acoes__alvo-topo--desafio">
  <img src="{{img}}" alt=""> <strong>{{nome}}</strong>
  {{#if quebrado}}<span class="op2-painel-trava">· {{localize "OP2.Desafio.Quebrado"}}</span>{{/if}}
  {{#if destrancado}}<span class="op2-painel-trava">· {{localize "OP2.Desafio.Destrancou"}}</span>{{/if}}
</div>
{{!-- Só as abordagens que o mestre marcou neste obstáculo. --}}
<div class="op2-acoes__grupo">
  {{#if abordagens.arrombar}}
    <button type="button" class="op2-botao op2-botao--pequeno" data-action="arrombar"
      data-desafio-uuid="{{uuid}}" {{#if quebrado}}disabled{{/if}} {{#if destrancado}}disabled{{/if}}
      data-tooltip="{{localize 'OP2.Desafio.Arrombar'}}">
      <i class="fa-solid fa-hammer" aria-hidden="true"></i>
      <span class="op2-acoes__rotulo">{{localize "OP2.Desafio.Arrombar"}}</span>
    </button>
  {{/if}}
  {{#if abordagens.destrancar}}
    <button type="button" class="op2-botao op2-botao--pequeno" data-action="destrancar"
      data-desafio-uuid="{{uuid}}" {{#if quebrado}}disabled{{/if}} {{#if destrancado}}disabled{{/if}}
      data-tooltip="{{localize 'OP2.Desafio.Destrancar'}}">
      <i class="fa-solid fa-key" aria-hidden="true"></i>
      <span class="op2-acoes__rotulo">{{localize "OP2.Desafio.Destrancar"}}</span>
    </button>
  {{/if}}
  {{#if abordagens.hackTecnico}}
    <button type="button" class="op2-botao op2-botao--pequeno" data-action="hackTecnico"
      data-desafio-uuid="{{uuid}}" {{#if hackTecnicoResolvido}}disabled{{/if}}
      data-tooltip="{{localize 'OP2.Desafio.HackTecnico'}}">
      <i class="fa-solid fa-laptop-code" aria-hidden="true"></i>
      <span class="op2-acoes__rotulo">{{localize "OP2.Desafio.HackTecnico"}}</span>
    </button>
  {{/if}}
  {{#if abordagens.hackSocial}}
    <button type="button" class="op2-botao op2-botao--pequeno" data-action="hackSocial"
      data-desafio-uuid="{{uuid}}" {{#if hackSocialResolvido}}disabled{{/if}}
      data-tooltip="{{localize 'OP2.Desafio.HackSocial'}}">
      <i class="fa-solid fa-comments" aria-hidden="true"></i>
      <span class="op2-acoes__rotulo">{{localize "OP2.Desafio.HackSocial"}}</span>
    </button>
  {{/if}}
  {{#if abordagens.sustentar}}
    <button type="button" class="op2-botao op2-botao--pequeno" data-action="sustentarDesafio"
      data-desafio-uuid="{{uuid}}" data-tooltip="{{localize 'OP2.Desafio.Sustentar'}} (DT {{sustentarDt}})">
      <i class="fa-solid fa-weight-hanging" aria-hidden="true"></i>
      <span class="op2-acoes__rotulo">{{localize "OP2.Desafio.Sustentar"}} (DT {{sustentarDt}})</span>
    </button>
  {{/if}}
  {{#if abordagens.generico}}
    <button type="button" class="op2-botao op2-botao--pequeno" data-action="desafioGenerico"
      data-desafio-uuid="{{uuid}}" {{#if genericoResolvido}}disabled{{/if}} data-tooltip="{{genericoRotulo}}">
      <i class="fa-solid fa-circle-question" aria-hidden="true"></i>
      <span class="op2-acoes__rotulo">{{genericoRotulo}}</span>
    </button>
  {{/if}}
  {{#unless temAlgumaAbordagem}}
    <span class="op2-ajuda">{{localize "OP2.Desafio.SemAbordagem"}}</span>
  {{/unless}}
</div>
