{{!-- Nome no topo, ocupando a largura toda; abaixo, retrato à esquerda e duas colunas
      empilhadas (identidade / atributos) à direita; PV e PD por último, ocupando a
      largura toda. O layout de 3 atributos lado a lado cortava "EMOÇÃO" em janelas
      estreitas — cada atributo com a própria linha resolve isso de vez, e ainda sobra
      espaço para o nome completo do atributo em qualquer largura (achado em uso real). --}}
<header class="op2-cabecalho op2-moldura">
  <input type="text" class="op2-nome op2-cabecalho__nome" name="name" value="{{actor.name}}"
    placeholder="{{localize 'OP2.Ficha.SemNome'}}" {{#unless editavel}}disabled{{/unless}}>

  <div class="op2-cabecalho__retrato">
    <img src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img"
      {{#unless editavel}}class="somente-leitura"{{/unless}}>
  </div>

  <div class="op2-cabecalho__identidade">
    <label class="op2-tag op2-tag--perfil op2-tag--bloco">
      <select name="system.perfil" {{#unless editavel}}disabled{{/unless}} aria-label="{{localize 'OP2.Campo.Perfil'}}">
        {{#each perfis}}
          <option value="{{chave}}" {{#if (op2Eq chave @root.sistema.perfil)}}selected{{/if}}>{{rotulo}}</option>
        {{/each}}
      </select>
    </label>

    <input type="text" class="op2-ocupacao" name="system.ocupacao" value="{{sistema.ocupacao}}"
      placeholder="{{localize 'OP2.Campo.Ocupacao'}}" {{#unless editavel}}disabled{{/unless}}
      aria-label="{{localize 'OP2.Campo.Ocupacao'}}">

    <div class="op2-identidade__linha">
      <label class="op2-nivel">
        <span>{{localize "OP2.Campo.Nivel"}}</span>
        <input type="number" name="system.nivel" value="{{sistema.nivel}}" min="1" max="10"
          {{#unless editavel}}disabled{{/unless}}>
      </label>

      {{!-- NEX é a progressão paranormal (spec §1); o playtest não publica a mecânica
            ainda, mas o campo existe na ficha desde já (spec §11). --}}
      <label class="op2-nivel" data-tooltip="{{localize 'OP2.Campo.NexAjuda'}}">
        <span>{{localize "OP2.Campo.Nex"}}</span>
        <input type="number" name="system.nex" value="{{sistema.nex}}" min="0" max="100"
          {{#unless editavel}}disabled{{/unless}}>
      </label>
    </div>

    {{!-- As ações de investigação moram aqui, não no painel: na ficha o personagem
          que age é este, sem ambiguidade. No painel, um jogador com mais de um
          personagem não teria como escolher por qual deles o botão agiria (achado
          em uso real). --}}
    <button type="button" class="op2-botao op2-acoes-investigacao" data-action="abrirAcoesInvestigacao"
      data-tooltip="{{localize 'OP2.Acoes.Ajuda'}}" aria-label="{{localize 'OP2.Acoes.Titulo'}}">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      {{localize "OP2.Acoes.Botao"}}
    </button>
  </div>

  <div class="op2-atributos">
    <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Atributos"}}</span>
    {{#each atributos}}
      <div class="op2-atributo{{#if reduzido}} op2-atributo--reduzido{{/if}}">
        <button type="button" class="op2-atributo__nome" data-action="rolar" data-chave="{{chave}}"
          data-tooltip="{{localize 'OP2.Pericia.Rolar'}}">{{rotulo}}</button>
        {{> (op2Caminho "partials/controle-dado") caminho=caminho icone=icone valorAtual=die
            reduzido=reduzido dica=dica}}
        {{> (op2Caminho "partials/abrir-dialogo") chave=chave}}
      </div>
    {{/each}}
  </div>

  <div class="op2-recursos op2-cabecalho__recursos">
    {{> (op2Caminho "partials/trilha-recurso") chave="pv" rotulo="OP2.Recurso.pv"
        value=recursos.pv.value max=recursos.pv.max tracos=recursos.pv.tracos critico=recursos.pv.critico}}
    {{> (op2Caminho "partials/trilha-recurso") chave="pd" rotulo="OP2.Recurso.pd"
        value=recursos.pd.value max=recursos.pd.max tracos=recursos.pd.tracos critico=recursos.pd.critico}}
  </div>

  {{!-- Barra de ímpeto (habilidade de perfil do Executor nas fichas do Ato I): três
        espaços, um por falha. Só aparece para quem tem a barra. --}}
  {{#if impeto.tem}}
    <div class="op2-impeto op2-cabecalho__impeto">
      <span class="op2-tag op2-tag--pequena">{{localize "OP2.Impeto.Titulo"}}</span>
      <div class="op2-impeto__barra" role="group" aria-label="{{localize 'OP2.Impeto.Titulo'}}">
        {{#each impeto.espacos}}
          <button type="button" class="op2-impeto__espaco{{#if cheio}} op2-impeto__espaco--cheio{{/if}}"
            data-action="definirImpeto" data-valor="{{n}}" {{#unless @root.editavel}}disabled{{/unless}}
            data-tooltip="{{localize 'OP2.Impeto.Dica'}}" aria-label="{{n}}"></button>
        {{/each}}
      </div>
      {{#if impeto.podeGastarPasso}}
        {{!-- Barra cheia: o rótulo longo em duas linhas estourava a faixa. Ícone mais
              texto curto, e a explicação inteira no tooltip. --}}
        <button type="button" class="op2-botao op2-botao--pequeno op2-impeto__gastar"
          data-action="gastarImpetoAtributo" data-tooltip="{{localize 'OP2.Impeto.PassoDica'}}">
          <i class="fa-solid fa-arrow-up-right-dots" aria-hidden="true"></i>
          {{localize "OP2.Impeto.Passo"}}
        </button>
      {{/if}}
    </div>
  {{/if}}

  {{!-- Estado ativo: redução da falha crítica e/ou aumento do Ímpeto, com a saída
        dos dois no mesmo lugar (encerrar a cena zera ambos). --}}
  {{#if (op2Ou temReducao aumentos.length)}}
    <div class="op2-estado op2-cabecalho__estado">
      {{#if temReducao}}
        <span class="op2-estado__texto">
          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
          {{localize "OP2.Atributo.Reduzido"}}
        </span>
      {{/if}}
      {{#each aumentos}}
        <span class="op2-estado__texto op2-estado__texto--aumento">
          <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
          {{localize "OP2.Atributo.Aumentado" atributo=rotulo base=base dado=dado}}
        </span>
      {{/each}}
      <button type="button" class="op2-botao op2-botao--pequeno" data-action="encerrarCena">
        <i class="fa-solid fa-hourglass-end"></i> {{localize "OP2.Cena.Encerrar"}}
      </button>
    </div>
  {{/if}}
</header>
