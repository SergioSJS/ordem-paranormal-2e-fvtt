<section class="op2-painel tab {{tabs.habilidades.cssClass}}" data-group="principal" data-tab="habilidades">
  <div class="op2-painel__topo">
    <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Habilidades"}}</span>
    {{#if editavel}}
      <button type="button" class="op2-botao op2-botao--fantasma" data-action="criarItem" data-tipo="habilidade">
        <i class="fa-solid fa-plus"></i> {{localize "OP2.Habilidade.Adicionar"}}
      </button>
    {{/if}}
  </div>

  {{#if habilidades.length}}
    <ul class="op2-lista-itens">
      {{#each habilidades}}
        <li class="op2-item{{#if barra}} op2-item--com-barra{{/if}}" data-item-id="{{item.id}}">
          <img class="op2-item__icone" src="{{item.img}}" alt="">
          <div class="op2-item__texto">
            <button type="button" class="op2-item__nome" data-action="editarItem">{{item.name}}</button>
            <span class="op2-item__meta">
              {{localize (op2Concat "OP2.Habilidade.Origem." item.system.origem)}}
              {{#if item.system.custo}} · {{item.system.custo}}{{/if}}
            </span>

            {{#if descricao}}
              <div class="op2-item__descricao">{{{descricao}}}</div>
            {{/if}}

            {{!-- A barra É a habilidade: o estado mora no item, então apagar a
                  habilidade leva a barra junto. --}}
            {{#if barra}}
              <div class="op2-impeto">
                <div class="op2-impeto__barra" role="group" aria-label="{{localize 'OP2.Impeto.Titulo'}}">
                  {{#each barra.espacos}}
                    <button type="button" class="op2-impeto__espaco{{#if cheio}} op2-impeto__espaco--cheio{{/if}}"
                      data-action="definirImpeto" data-item-id="{{../item.id}}" data-valor="{{n}}"
                      {{#unless @root.editavel}}disabled{{/unless}}
                      data-tooltip="{{localize 'OP2.Impeto.Dica'}}" aria-label="{{n}}"></button>
                  {{/each}}
                </div>
                {{#if barra.cheia}}
                  <button type="button" class="op2-botao op2-botao--pequeno op2-impeto__gastar"
                    data-action="gastarImpetoAtributo" data-item-id="{{item.id}}"
                    data-tooltip="{{localize 'OP2.Impeto.PassoDica'}}">
                    <i class="fa-solid fa-arrow-up-right-dots" aria-hidden="true"></i>
                    {{localize "OP2.Impeto.Passo"}}
                  </button>
                {{/if}}
              </div>
            {{/if}}
          </div>
          {{#if @root.editavel}}
            <button type="button" class="op2-botao-icone" data-action="apagarItem"
              data-tooltip="{{localize 'OP2.Item.Apagar'}}" aria-label="{{localize 'OP2.Item.Apagar'}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          {{/if}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="op2-vazio">{{localize "OP2.Habilidade.Vazio"}}</p>
  {{/if}}
</section>
