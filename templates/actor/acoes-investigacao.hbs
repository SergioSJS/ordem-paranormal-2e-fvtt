<div class="op2-acoes-corpo">
  {{#unless temInvestigacao}}
    <p class="op2-ajuda">{{localize "OP2.Acoes.SemInvestigacao"}}</p>
  {{else}}
    <header class="op2-acoes__topo">
      {{#if (op2Maior investigacoes.length 1)}}
        <label class="op2-campo op2-campo--inline">
          <span>{{localize "OP2.Investigacao.Visualizando"}}</span>
          <select data-seletor-investigacao>
            {{#each investigacoes}}
              <option value="{{uuid}}" {{#if (op2Eq uuid @root.investigacaoAtualUuid)}}selected{{/if}}>{{nome}}</option>
            {{/each}}
          </select>
        </label>
      {{else}}
        <span class="op2-tag op2-tag--pequena">{{nomeInvestigacao}}</span>
      {{/if}}
    </header>

    {{!-- Três abas: uma lista só virava rolagem sem fim conforme a mesa revela coisas,
          e o desafio ficava no meio dos pontos (achado em uso real). --}}
    <nav class="op2-abas tabs" data-group="principal" aria-label="{{localize 'OP2.Secao.Conteudo'}}">
      {{#each tabs}}
        <button type="button" class="op2-aba {{cssClass}}" data-action="tab" data-group="{{group}}" data-tab="{{id}}"
          aria-pressed="{{#if active}}true{{else}}false{{/if}}">
          {{localize label}}
          {{#if (lookup @root.contagens id)}}<span class="op2-painel-contagem">{{lookup @root.contagens id}}</span>{{/if}}
        </button>
      {{/each}}
    </nav>

    {{!-- Um ícone por ação e o rótulo num span próprio: o ícone nunca some, e é o
          texto que encolhe se faltar largura. --}}
    <section class="op2-acoes__aba tab {{tabs.livres.cssClass}}" data-group="principal" data-tab="livres">
      <div class="op2-acoes__grupo">
        <button type="button" class="op2-botao op2-botao--pequeno" data-action="recapitular"
          {{#if recapitularUsado.usado}}disabled{{/if}} data-tooltip="{{localize 'OP2.Investigacao.Recapitular'}}">
          <i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>
          <span class="op2-acoes__rotulo">{{localize "OP2.Investigacao.Recapitular"}}
            {{#if recapitularUsado.usado}}<span class="op2-painel-trava">· {{recapitularUsado.nome}}</span>{{/if}}</span>
        </button>
        <button type="button" class="op2-botao op2-botao--pequeno" data-action="compartilhar"
          {{#unless temAliados}}disabled data-tooltip="{{localize 'OP2.Acoes.SemAliado'}}"{{else}}data-tooltip="{{localize 'OP2.Investigacao.Compartilhar'}}"{{/unless}}
          {{#if compartilharUsado.usado}}disabled{{/if}}>
          <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
          <span class="op2-acoes__rotulo">{{localize "OP2.Investigacao.Compartilhar"}}
            {{#if compartilharUsado.usado}}<span class="op2-painel-trava">· {{compartilharUsado.nome}}</span>{{/if}}</span>
        </button>
        <button type="button" class="op2-botao op2-botao--pequeno op2-botao--perigo" data-action="atacar"
          {{#unless temAlvosDeAtaque}}disabled data-tooltip="{{localize 'OP2.Acoes.SemAlvo'}}"{{else}}data-tooltip="{{localize 'OP2.Combate.Atacar'}}"{{/unless}}>
          <i class="fa-solid fa-hand-fist" aria-hidden="true"></i>
          <span class="op2-acoes__rotulo">{{localize "OP2.Combate.Atacar"}}</span>
        </button>
        <button type="button" class="op2-botao op2-botao--pequeno" data-action="usarRecurso"
          {{#unless temRecursos}}disabled data-tooltip="{{localize 'OP2.Recurso.SemItens'}}"{{else}}data-tooltip="{{localize 'OP2.Recurso.Titulo'}}"{{/unless}}>
          <i class="fa-solid fa-wand-sparkles" aria-hidden="true"></i>
          <span class="op2-acoes__rotulo">{{localize "OP2.Recurso.Titulo"}}</span>
        </button>
        <button type="button" class="op2-botao op2-botao--pequeno" data-action="ajudar"
          {{#if temAliados}}data-tooltip="{{localize 'OP2.Ajuda.EscolhaAjuda'}}"
          {{else}}disabled data-tooltip="{{localize 'OP2.Ajuda.SemAliados'}}"{{/if}}>
          <i class="fa-solid fa-handshake-angle" aria-hidden="true"></i>
          <span class="op2-acoes__rotulo">{{localize "OP2.Ajuda.Titulo"}}</span>
        </button>
        <button type="button" class="op2-botao op2-botao--pequeno" data-action="alcancar" data-modo="seguro"
          data-tooltip="{{localize 'OP2.Desafio.AlcancarSeguro'}}">
          <i class="fa-solid fa-person-walking" aria-hidden="true"></i>
          <span class="op2-acoes__rotulo">{{localize "OP2.Desafio.AlcancarSeguro"}}</span>
        </button>
        <button type="button" class="op2-botao op2-botao--pequeno" data-action="alcancar" data-modo="arriscado"
          data-tooltip="{{localize 'OP2.Desafio.AlcancarArriscado'}}">
          <i class="fa-solid fa-person-running" aria-hidden="true"></i>
          <span class="op2-acoes__rotulo">{{localize "OP2.Desafio.AlcancarArriscado"}}</span>
        </button>
        {{#if sustentando}}
          <button type="button" class="op2-botao op2-botao--pequeno op2-botao--perigo" data-action="pararDeSustentar"
            data-tooltip="{{localize 'OP2.Desafio.PararDeSustentar'}}">
            <i class="fa-solid fa-hand" aria-hidden="true"></i>
            <span class="op2-acoes__rotulo">{{localize "OP2.Desafio.PararDeSustentar"}}</span>
          </button>
        {{else}}
          <button type="button" class="op2-botao op2-botao--pequeno" data-action="sustentar"
            data-tooltip="{{localize 'OP2.Desafio.Sustentar'}}">
            <i class="fa-solid fa-weight-hanging" aria-hidden="true"></i>
            <span class="op2-acoes__rotulo">{{localize "OP2.Desafio.Sustentar"}}</span>
          </button>
        {{/if}}
        {{#if temLaser}}
          <button type="button" class="op2-botao op2-botao--pequeno" data-action="usarLaser"
            data-tooltip="{{localize 'OP2.Ferramenta.Subtipo.laser'}}">
            <i class="fa-solid fa-satellite-dish" aria-hidden="true"></i>
            <span class="op2-acoes__rotulo">{{localize "OP2.Ferramenta.Subtipo.laser"}}</span>
          </button>
        {{/if}}
      </div>
    </section>

    {{!-- Investigar um ponto é interagir ou examinar com ele — não existe uma terceira
          ação "Investigar" (spec §6.3). Interagir vem primeiro: é agir sem teste, o
          mestre narra. --}}
    <section class="op2-acoes__aba tab {{tabs.pontos.cssClass}}" data-group="principal" data-tab="pontos">
      <input type="search" class="op2-painel-filtro" data-filtro-acoes value="{{filtro}}"
        placeholder="{{localize 'OP2.Acoes.Filtrar'}}" aria-label="{{localize 'OP2.Acoes.Filtrar'}}">
      {{#unless pois.length}}
        <p class="op2-ajuda">{{localize "OP2.Acoes.SemPOIs"}}</p>
      {{/unless}}
      <ol class="op2-acoes__lista">
        {{#each pois}}
          <li class="op2-acoes__linha" data-acao-card data-nome="{{nome}}">
            <div class="op2-acoes__linha-topo">
              <img src="{{img}}" alt="">
              <strong>{{nome}}</strong>
              {{#if totalDesafios}}
                <button type="button" class="op2-acoes__atalho" data-action="irParaDesafios" data-nome="{{nome}}"
                  data-tooltip="{{localize 'OP2.Acoes.VerDesafios'}}">
                  <i class="fa-solid fa-lock" aria-hidden="true"></i> {{totalDesafios}}
                </button>
              {{/if}}
            </div>
            <div class="op2-acoes__grupo">
              <button type="button" class="op2-botao op2-botao--pequeno" data-action="interagir"
                data-poi-uuid="{{uuid}}" data-tooltip="{{localize 'OP2.Investigacao.InteragirDica'}}">
                <i class="fa-solid fa-hand-pointer" aria-hidden="true"></i>
                <span class="op2-acoes__rotulo">{{localize "OP2.Investigacao.Interagir"}}</span>
              </button>
              <button type="button" class="op2-botao op2-botao--pequeno" data-action="examinar"
                data-poi-uuid="{{uuid}}" data-tooltip="{{localize 'OP2.Painel.ExaminarDica'}}">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <span class="op2-acoes__rotulo">{{localize "OP2.Investigacao.Examinar"}}</span>
              </button>
              {{#each ferramentas}}
                <button type="button" class="op2-botao op2-botao--pequeno"
                  data-action="{{#if (op2Eq chave 'laboratorio')}}usarLaboratorio{{else if (op2Eq chave 'radio')}}usarRadio{{else}}usarFerramenta{{/if}}"
                  data-poi-uuid="{{../uuid}}" data-ferramenta="{{chave}}" data-tooltip="{{rotulo}}">
                  <i class="fa-solid {{#if (op2Eq chave 'laboratorio')}}fa-flask{{else if (op2Eq chave 'radio')}}fa-radio{{else}}fa-screwdriver-wrench{{/if}}" aria-hidden="true"></i>
                  <span class="op2-acoes__rotulo">{{rotulo}}</span>
                </button>
              {{/each}}
            </div>
          </li>
        {{/each}}
      </ol>
    </section>

    {{!-- Todos os desafios à vista, com o ponto a que pertencem como rótulo. --}}
    <section class="op2-acoes__aba tab {{tabs.desafios.cssClass}}" data-group="principal" data-tab="desafios">
      <input type="search" class="op2-painel-filtro" data-filtro-acoes value="{{filtro}}"
        placeholder="{{localize 'OP2.Acoes.Filtrar'}}" aria-label="{{localize 'OP2.Acoes.Filtrar'}}">
      {{#unless desafios.length}}
        <p class="op2-ajuda">{{localize "OP2.Acoes.SemDesafios"}}</p>
      {{/unless}}
      <ol class="op2-acoes__lista">
        {{#each desafios}}
          <li class="op2-acoes__linha" data-acao-card data-nome="{{nome}}">
            {{> (op2Caminho "actor/partials/acoes-desafio")}}
          </li>
        {{/each}}
      </ol>
    </section>
  {{/unless}}
</div>
