<div class="op2-ficha-npc">
  <header class="op2-cabecalho op2-moldura">
    <div class="op2-cabecalho__retrato op2-cabecalho__retrato--pequeno">
      <img src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
    </div>
    <div class="op2-cabecalho__identidade">
      <input type="text" class="op2-nome" name="name" value="{{actor.name}}" {{#unless editavel}}disabled{{/unless}}>
      <input type="text" class="op2-ocupacao" name="system.categoria" value="{{sistema.categoria}}"
        placeholder="{{localize 'OP2.Npc.Categoria'}}" {{#unless editavel}}disabled{{/unless}}>
      <div class="op2-recursos">
        {{> (op2Caminho "partials/trilha-recurso") chave="pv" rotulo="OP2.Recurso.pv"
            value=sistema.recursos.pv.value max=sistema.recursos.pv.max
            tracos=recursos.pv.tracos critico=recursos.pv.critico}}
        {{> (op2Caminho "partials/trilha-recurso") chave="pd" rotulo="OP2.Recurso.pd"
            value=sistema.recursos.pd.value max=sistema.recursos.pd.max
            tracos=recursos.pd.tracos critico=recursos.pd.critico}}
      </div>
    </div>
  </header>

  {{!-- `.op2-painel` é a classe das ABAS da ficha de personagem (`display:none` sem
        `.active`); usar ela aqui deixava Atributos, Perícias e Notas invisíveis o
        tempo todo. `.op2-npc-secao` é sempre visível, de propósito. --}}
  <section class="op2-npc-secao op2-moldura">
    <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Atributos"}}</span>
    <div class="op2-atributos op2-atributos--npc">
      {{#each atributos}}
        <div class="op2-atributo">
          <button type="button" class="op2-atributo__nome" data-action="rolar" data-chave="{{chave}}"
            data-tooltip="{{localize 'OP2.Pericia.Rolar'}}">{{rotulo}}</button>
          {{> (op2Caminho "partials/controle-dado") caminho=caminho icone=icone valorAtual=die}}
        </div>
      {{/each}}
    </div>
  </section>

  {{#if combateNovo}}
    <section class="op2-npc-secao op2-moldura" data-npc-combate>
      <div class="op2-painel__topo">
        <span class="op2-tag op2-tag--secao">{{localize "OP2.Npc.Ataques"}}</span>
        <label class="op2-campo op2-campo--inline"><span>RD</span>
          <input type="number" name="system.rd" value="{{sistema.rd}}" min="0" {{#unless editavel}}disabled{{/unless}}></label>
        {{#if editavel}}<button type="button" class="op2-botao op2-botao--fantasma" data-action="adicionarAtaque"><i class="fa-solid fa-plus"></i> {{localize "OP2.Npc.AdicionarAtaque"}}</button>{{/if}}
      </div>
      {{#each ataques}}
        <div class="op2-npc-ataque">
          <input type="text" name="system.ataques.{{@index}}.nome" value="{{nome}}" placeholder="{{localize 'OP2.Npc.AtaqueNome'}}" {{#unless ../editavel}}disabled{{/unless}}>
          <input type="text" name="system.ataques.{{@index}}.dados" value="{{dados}}" placeholder="d8+d6" {{#unless ../editavel}}disabled{{/unless}}>
          <span>RA+</span>
          <input type="number" name="system.ataques.{{@index}}.bonusDano" value="{{bonusDano}}" {{#unless ../editavel}}disabled{{/unless}}>
          {{#if ../editavel}}<button type="button" class="op2-botao op2-botao--fantasma" data-action="removerAtaque" data-indice="{{@index}}" aria-label="{{localize 'OP2.Npc.RemoverAtaque'}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}
          {{!-- O formulário manda o ataque inteiro: campo que não está aqui volta ao padrão. --}}
          <input type="hidden" name="system.ataques.{{@index}}.tipo" value="{{tipo}}">
          <div class="op2-npc-ataque__efeito">
            <label data-tooltip="{{localize 'OP2.Npc.EfeitoAjuda'}}"><span>{{localize "OP2.Npc.Efeito"}}</span>
              <select name="system.ataques.{{@index}}.efeito" {{#unless ../editavel}}disabled{{/unless}}>
                <option value="" {{#unless efeito}}selected{{/unless}}>{{localize "OP2.Npc.EfeitoDano"}}</option>
                <option value="agarrar" {{#if (op2Eq efeito "agarrar")}}selected{{/if}}>{{localize "OP2.Npc.EfeitoAgarrar"}}</option>
              </select></label>
            <label><span>{{localize "OP2.Npc.DanoPorRodada"}}</span>
              <input type="text" name="system.ataques.{{@index}}.danoPorRodada" value="{{danoPorRodada}}" placeholder="1d6" {{#unless ../editavel}}disabled{{/unless}}></label>
            <label><span>{{localize "OP2.Npc.PassosSoltar"}}</span>
              <input type="number" name="system.ataques.{{@index}}.passosSoltar" value="{{passosSoltar}}" {{#unless ../editavel}}disabled{{/unless}}></label>
          </div>
        </div>
      {{/each}}
    </section>
  {{/if}}

  <section class="op2-npc-secao op2-moldura">
    <div class="op2-painel__topo">
      <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Pericias"}}</span>
      {{#if editavel}}
        <button type="button" class="op2-botao op2-botao--fantasma" data-action="adicionarPericia">
          <i class="fa-solid fa-plus"></i> {{localize "OP2.Npc.AdicionarPericia"}}
        </button>
      {{/if}}
    </div>
    <p class="op2-ajuda">{{localize "OP2.Npc.PericiasAjuda"}}</p>

    {{#if pericias.length}}
      <div class="op2-lista-pericias op2-lista-pericias--npc">
        {{#each pericias}}
          <div class="op2-pericia-npc" data-sub="{{sub}}">
            <button type="button" class="op2-pericia-npc__nome" data-action="rolar" data-chave="{{sub}}"
              data-tooltip="{{localize 'OP2.Pericia.Rolar'}}">{{rotulo}}</button>
            {{> (op2Caminho "partials/controle-dado") caminho=caminho icone=icone valorAtual=die}}
            {{#if @root.editavel}}
              <button type="button" class="op2-botao-icone" data-action="removerPericia" data-sub="{{sub}}"
                data-tooltip="{{localize 'OP2.Npc.RemoverPericia'}}"
                aria-label="{{localize 'OP2.Npc.RemoverPericia'}}"><i class="fa-solid fa-xmark"></i></button>
            {{/if}}
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="op2-vazio">{{localize "OP2.Npc.SemPericias"}}</p>
    {{/if}}
  </section>

  <section class="op2-npc-secao op2-npc-secao--notas op2-moldura">
    <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Notas"}}</span>
    {{formInput fields.notas value=sistema.notas enriched=notasEnriquecidas
      toggled=true editable=editavel name="system.notas"}}
  </section>
</div>
