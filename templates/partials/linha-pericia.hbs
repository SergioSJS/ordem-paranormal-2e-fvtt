{{!-- A linha da ficha oficial: nome, dado da perícia, dado do atributo pareado. --}}
<div class="op2-pericia" data-chave="{{chave}}">
  <button type="button" class="op2-pericia__nome" data-action="rolar" data-chave="{{chave}}"
    data-tooltip="{{localize 'OP2.Pericia.Rolar'}}">{{rotulo}}</button>

  {{> (op2Caminho "partials/controle-dado") caminho=caminho icone=icone valorAtual=die}}

  <span class="op2-pericia__mais" aria-hidden="true">+</span>

  <span class="op2-pericia__atributo" data-tooltip="{{atributo.rotulo}}">
    {{{atributo.icone}}}
    <span class="op2-pericia__atributo-nome">{{atributo.rotulo}}</span>
  </span>
</div>
