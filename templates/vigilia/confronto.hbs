{{!-- Card de confronto: quem fez o quê em quem, lido de longe. Os dois retratos com a seta,
      o veredito grande, o dano em número grande com o nome de quem leva, e os dados de
      cada lado embaixo do retrato dele. Um card por ação: os dados vêm dentro. --}}
{{#*inline "lado"}}
  <figure class="op2-confronto__lado{{#if venceu}} op2-confronto__lado--venceu{{/if}}">
    <img src="{{img}}" alt="">
    <figcaption>{{nome}}</figcaption>
    {{#if dados.length}}
      <span class="op2-confronto__dados">
        {{#each dados}}<span class="op2-card__dado{{#unless contado}} descartado{{/unless}}" data-tooltip="{{componente.rotulo}}">{{op2DadoResultado this}}</span>{{/each}}
        {{#if modificador}}<span class="op2-card__modificador">{{op2Sinal modificador}}</span>{{/if}}
        <span class="op2-confronto__total">= {{total}}</span>
      </span>
    {{else if total}}
      <span class="op2-confronto__dados"><span class="op2-confronto__total">{{total}}</span></span>
    {{/if}}
  </figure>
{{/inline}}

<div class="op2 op2-card op2-confronto op2-card--{{estilo}}" data-legenda="{{legenda}}">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{titulo}}</span>
    {{#if selo}}<span class="op2-card__dt">{{selo}}</span>{{/if}}
  </header>

  <div class="op2-confronto__duelo">
    {{> lado esquerda}}
    <span class="op2-confronto__seta" aria-hidden="true"><i class="fa-solid {{icone}}"></i></span>
    {{> lado direita}}
  </div>

  <p class="op2-confronto__veredito op2-confronto__veredito--{{veredito.classe}}">{{veredito.rotulo}}</p>

  {{#each golpes}}
    <p class="op2-confronto__golpe">
      <strong class="op2-confronto__dano">{{dano}}</strong>
      <span>{{{texto}}}</span>
    </p>
  {{/each}}

  {{#if linhas.length}}
    <ul class="op2-card__lista">{{#each linhas}}<li>{{{this}}}</li>{{/each}}</ul>
  {{/if}}

  {{#if falhaCritica}}{{> (op2Caminho "partials/falha-critica") atorId=atorId}}{{/if}}

  {{#if botoes.length}}
    <div class="op2-card__acoes">
      {{#each botoes}}
        <button type="button" class="op2-botao op2-botao--pequeno{{#if perigo}} op2-botao--perigo{{/if}}"
          {{#if soMestre}}data-op2-gm{{/if}} data-op2-acao="{{acao}}" {{{atributos}}}>{{rotulo}}</button>
      {{/each}}
    </div>
  {{/if}}
</div>
