<div class="op2-item-ficha">
  <header class="op2-item-ficha__topo">
    <img src="{{item.img}}" alt="" data-action="editImage" data-edit="img">
    <input type="text" class="op2-nome" name="name" value="{{item.name}}" {{#unless editavel}}disabled{{/unless}}>
  </header>

  <div class="op2-grade-campos">
    <label class="op2-campo">
      <span>{{localize "OP2.Equipamento.Quantidade"}}</span>
      <input type="number" name="system.quantidade" value="{{sistema.quantidade}}" min="0"
        {{#unless editavel}}disabled{{/unless}}>
    </label>

    <label class="op2-campo op2-campo--inline">
      <input type="checkbox" name="system.equipado" {{#if sistema.equipado}}checked{{/if}}
        {{#unless editavel}}disabled{{/unless}}>
      <span>{{localize "OP2.Equipamento.Equipado"}}</span>
    </label>

    <label class="op2-campo op2-campo--inline">
      <input type="checkbox" name="system.arma" {{#if sistema.arma}}checked{{/if}}
        {{#unless editavel}}disabled{{/unless}}>
      <span>{{localize "OP2.Equipamento.Arma"}}</span>
    </label>
  </div>
  <p class="op2-ajuda">{{localize "OP2.Equipamento.ArmaAjuda"}}</p>

  {{#if combateNovo}}
    <fieldset class="op2-cargas">
      <legend>{{localize "OP2.Equipamento.Combate"}}</legend>
      <div class="op2-grade-campos">
        <label class="op2-campo">
          <span>{{localize "OP2.Equipamento.TipoAtaque"}}</span>
          <select name="system.ataque.tipo" {{#unless editavel}}disabled{{/unless}}>
            <option value="" {{#if (op2Eq sistema.ataque.tipo "")}}selected{{/if}}>{{localize "OP2.Equipamento.NaoArma"}}</option>
            <option value="corpo" {{#if (op2Eq sistema.ataque.tipo "corpo")}}selected{{/if}}>{{localize "OP2.Fase.corpo"}}</option>
            <option value="distancia" {{#if (op2Eq sistema.ataque.tipo "distancia")}}selected{{/if}}>{{localize "OP2.Fase.distancia"}}</option>
          </select>
        </label>
        <label class="op2-campo"><span>{{localize "OP2.Equipamento.BonusDano"}}</span>
          <input type="number" name="system.ataque.bonusDano" value="{{sistema.ataque.bonusDano}}" {{#unless editavel}}disabled{{/unless}}></label>
        <label class="op2-campo"><span>{{localize "OP2.Equipamento.BonusTeste"}}</span>
          <input type="number" name="system.ataque.bonusTeste" value="{{sistema.ataque.bonusTeste}}" {{#unless editavel}}disabled{{/unless}}></label>
        <label class="op2-campo"><span>{{localize "OP2.Equipamento.MinimoCritico"}}</span>
          <input type="number" name="system.ataque.minimoCritico" value="{{sistema.ataque.minimoCritico}}" min="0" {{#unless editavel}}disabled{{/unless}}></label>
        <label class="op2-campo"><span>{{localize "OP2.Equipamento.IgnoraRd"}}</span>
          <input type="number" name="system.ataque.ignoraRd" value="{{sistema.ataque.ignoraRd}}" min="0" {{#unless editavel}}disabled{{/unless}}></label>
        <label class="op2-campo"><span>{{localize "OP2.Campo.Armadura"}}</span>
          <input type="number" name="system.armadura" value="{{sistema.armadura}}" min="0" {{#unless editavel}}disabled{{/unless}}></label>
      </div>
      <label class="op2-campo op2-campo--inline"><input type="checkbox" name="system.marcial" {{#if sistema.marcial}}checked{{/if}} {{#unless editavel}}disabled{{/unless}}>
        <span>{{localize "OP2.Equipamento.Marcial"}}</span></label>
      <label class="op2-campo"><span>{{localize "OP2.Equipamento.Passos"}}</span>
        <input type="text" name="system.passos" value="{{sistema.passos}}" placeholder="atletismo -1, furtividade -1" {{#unless editavel}}disabled{{/unless}}></label>
    </fieldset>
  {{/if}}

  <fieldset class="op2-cargas">
    <legend>{{localize "OP2.Equipamento.Cargas"}}</legend>
    <label class="op2-campo op2-campo--inline">
      <input type="checkbox" name="system.cargas.usa" {{#if sistema.cargas.usa}}checked{{/if}}
        {{#unless editavel}}disabled{{/unless}}>
      <span>{{localize "OP2.Equipamento.UsaCargas"}}</span>
    </label>

    {{#if sistema.cargas.usa}}
      <div class="op2-grade-campos">
        <label class="op2-campo">
          <span>{{localize "OP2.Recurso.Atual"}}</span>
          <input type="number" name="system.cargas.value" value="{{sistema.cargas.value}}" min="0"
            {{#unless editavel}}disabled{{/unless}}>
        </label>
        <label class="op2-campo">
          <span>{{localize "OP2.Recurso.Maximo"}}</span>
          <input type="number" name="system.cargas.max" value="{{sistema.cargas.max}}" min="0"
            {{#unless editavel}}disabled{{/unless}}>
        </label>
      </div>
    {{/if}}
  </fieldset>

  <label class="op2-campo">
    <span>{{localize "OP2.Equipamento.Descricao"}}</span>
    {{formInput fields.descricao value=sistema.descricao enriched=descricao toggled=true
      editable=editavel name="system.descricao"}}
  </label>
</div>
