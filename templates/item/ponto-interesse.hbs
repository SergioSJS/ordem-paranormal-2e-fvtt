<div class="op2-item-ficha op2-poi">
  <header class="op2-item-ficha__topo">
    <img src="{{item.img}}" alt="" data-action="editImage" data-edit="img">
    <input type="text" class="op2-nome" name="name" value="{{item.name}}" {{#unless editavel}}disabled{{/unless}}>
  </header>

  <nav class="op2-abas tabs" data-group="principal" aria-label="{{localize 'OP2.Secao.Conteudo'}}">
    {{#each tabs}}
      <button type="button" class="op2-aba {{cssClass}}" data-action="tab" data-group="{{group}}" data-tab="{{id}}"
        aria-pressed="{{active}}">{{localize label}}</button>
    {{/each}}
  </nav>

  <section class="op2-painel tab {{tabs.investigacao.cssClass}}" data-group="principal" data-tab="investigacao">
    <label class="op2-campo">
      <span>{{localize "OP2.POI.DescricaoBasica"}}</span>
      {{formInput fields.descricaoBasica value=sistema.descricaoBasica enriched=descricaoBasicaEnriquecida
        toggled=true editable=editavel name="system.descricaoBasica"}}
      <p class="op2-ajuda">{{localize "OP2.POI.DescricaoBasicaAjuda"}}</p>
    </label>

    <fieldset class="op2-poi__quadro">
      <legend>{{localize "OP2.POI.Quadro"}}</legend>
      <p class="op2-ajuda">{{localize "OP2.POI.QuadroAjuda"}}</p>

      <ol class="op2-poi__infos">
        {{#each informacoes}}
          <li class="op2-poi__info">
            <input type="hidden" name="system.informacoes.{{indice}}.id" value="{{id}}">
            <div class="op2-poi__info-linha">
              <select name="system.informacoes.{{indice}}.pericia" {{#unless @root.editavel}}disabled{{/unless}}>
                {{#each @root.opcoesPericia}}
                  <option value="{{chave}}" {{#if (op2Eq chave ../pericia)}}selected{{/if}}>{{rotulo}}</option>
                {{/each}}
              </select>
              <label class="op2-poi__dt">
                <span>{{localize "OP2.DT"}}</span>
                <input type="number" name="system.informacoes.{{indice}}.dt" value="{{dt}}" min="0" step="1"
                  inputmode="numeric" {{#unless @root.editavel}}disabled{{/unless}}>
              </label>
              {{!-- Rascunho → descobrível → aberta, o mesmo ciclo do painel. --}}
              <button type="button"
                class="op2-botao-icone op2-poi__info-oculta op2-poi-card__visibilidade--{{estado}}"
                data-action="cicloVisibilidadeInfo" data-info-id="{{id}}"
                {{#unless @root.editavel}}disabled{{/unless}}
                aria-label="{{localize (op2Concat 'OP2.POI.Visibilidade.' estado)}}"
                data-tooltip="{{localize (op2Concat 'OP2.POI.Visibilidade.' estado)}}">
                <i class="fa-solid {{#if (op2Eq estado 'rascunho')}}fa-eye-slash{{else if (op2Eq estado 'aberta')}}fa-eye{{else}}fa-magnifying-glass{{/if}}" aria-hidden="true"></i>
              </button>
              {{#if @root.editavel}}
                <button type="button" class="op2-botao op2-botao--pequeno op2-botao--perigo"
                  data-action="removerInformacao" data-info-id="{{id}}"
                  aria-label="{{localize 'OP2.POI.RemoverInformacao'}}">
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </div>
            <textarea name="system.informacoes.{{indice}}.texto" rows="2"
              {{#unless @root.editavel}}disabled{{/unless}}>{{texto}}</textarea>
          </li>
        {{/each}}
      </ol>

      {{#if editavel}}
        <button type="button" class="op2-botao op2-botao--pequeno" data-action="adicionarInformacao">
          <i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "OP2.POI.AdicionarInformacao"}}
        </button>
      {{/if}}
    </fieldset>
  </section>

  {{!-- Descrição contextual e ferramentas são só do mestre (spec §6.2). --}}
  {{#if ehGM}}
    <section class="op2-painel tab {{tabs.mestre.cssClass}}" data-group="principal" data-tab="mestre">
      <label class="op2-campo">
        <span>{{localize "OP2.POI.DescricaoContextual"}}</span>
        {{formInput fields.descricaoContextual value=sistema.descricaoContextual enriched=descricaoContextualEnriquecida
          toggled=true editable=editavel name="system.descricaoContextual"}}
        <p class="op2-ajuda">{{localize "OP2.POI.DescricaoContextualAjuda"}}</p>
      </label>

      <fieldset class="op2-poi__ferramentas">
        <legend>{{localize "OP2.POI.Ferramentas"}}</legend>
        <p class="op2-ajuda">{{localize "OP2.POI.FerramentasAjuda"}}</p>

        {{#each ferramentasConfiguradas}}
          <div class="op2-poi__ferramenta">
            {{#if ehRadio}}
              <fieldset class="op2-poi__radio">
                <legend>{{rotulo}}</legend>
                {{#each conjuntos}}
                  <div class="op2-poi__radio-conjunto">
                    <label class="op2-campo op2-campo--inline">
                      <input type="checkbox" name="system.ferramentas.radio.conjuntos.{{indice}}.verdadeiro"
                        {{#if verdadeiro}}checked{{/if}} {{#unless @root.editavel}}disabled{{/unless}}>
                      <span>{{localize "OP2.POI.RadioVerdadeiro"}}</span>
                    </label>
                    <input type="text" name="system.ferramentas.radio.conjuntos.{{indice}}.frase" value="{{frase}}"
                      placeholder="{{localize 'OP2.POI.RadioFrasePlaceholder'}}"
                      {{#unless @root.editavel}}disabled{{/unless}}>
                    {{#if @root.editavel}}
                      <button type="button" class="op2-botao-icone" data-action="removerConjuntoRadio" data-indice="{{indice}}"
                        aria-label="{{localize 'OP2.POI.RadioRemoverConjunto'}}">
                        <i class="fa-solid fa-trash" aria-hidden="true"></i>
                      </button>
                    {{/if}}
                  </div>
                {{/each}}
                {{#if @root.editavel}}
                  <button type="button" class="op2-botao op2-botao--pequeno" data-action="adicionarConjuntoRadio">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "OP2.POI.RadioAdicionarConjunto"}}
                  </button>
                {{/if}}
                <p class="op2-ajuda">{{localize "OP2.POI.RadioAjudaAutor"}}</p>
                <label class="op2-campo">
                  <span>{{localize "OP2.POI.RadioTexto"}}</span>
                  <textarea name="system.ferramentas.radio.texto" rows="2"
                    {{#unless @root.editavel}}disabled{{/unless}}>{{radioTexto}}</textarea>
                </label>
                <p class="op2-ajuda">{{localize "OP2.POI.RadioTextoAjuda"}}</p>
              </fieldset>
            {{else}}
              <label class="op2-campo">
                <span>{{rotulo}}</span>
                <textarea name="system.ferramentas.{{chave}}" rows="2"
                  {{#unless @root.editavel}}disabled{{/unless}}>{{valor}}</textarea>
              </label>
            {{/if}}
            {{#if @root.editavel}}
              <button type="button" class="op2-botao op2-botao--pequeno op2-botao--perigo"
                data-action="removerFerramenta" data-ferramenta="{{chave}}"
                aria-label="{{localize 'OP2.POI.RemoverFerramenta'}}">
                <i class="fa-solid fa-trash" aria-hidden="true"></i>
              </button>
            {{/if}}
          </div>
        {{/each}}

        {{#unless ferramentasConfiguradas.length}}
          <p class="op2-ajuda">{{localize "OP2.POI.FerramentasVazio"}}</p>
        {{/unless}}

        {{#if editavel}}
          <select class="op2-poi__seletor-ferramenta" data-seletor-ferramenta>
            <option value="">{{localize "OP2.POI.AdicionarFerramenta"}}</option>
            {{#each ferramentasDisponiveis}}
              <option value="{{chave}}">{{rotulo}}</option>
            {{/each}}
          </select>
        {{/if}}
      </fieldset>

      {{!-- Os desafios deste ponto (a porta, o cadeado, o painel): arrastar um Desafio
            de acesso para cá liga os dois; ao vincular o ponto a uma investigação,
            os desafios vão junto. --}}
      <fieldset class="op2-poi__desafios">
        <legend>{{localize "OP2.POI.Desafios"}}</legend>
        {{#unless desafiosVinculados.length}}
          <p class="op2-ajuda">{{localize "OP2.POI.DesafiosVazio"}}</p>
        {{/unless}}
        <ol class="op2-painel-ordem">
          {{#each desafiosVinculados}}
            <li class="op2-painel-ordem__linha">
              <img src="{{img}}" alt=""> <span>{{nome}}</span>
              <button type="button" class="op2-botao-icone" data-action="abrirDesafioVinculado" data-uuid="{{uuid}}"
                aria-label="{{localize 'OP2.Painel.AbrirDesafio'}}">
                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
              </button>
              {{#if @root.editavel}}
                <button type="button" class="op2-botao-icone" data-action="removerDesafioVinculado" data-uuid="{{uuid}}"
                  aria-label="{{localize 'OP2.Painel.RemoverDesafio'}}">
                  <i class="fa-solid fa-link-slash" aria-hidden="true"></i>
                </button>
              {{/if}}
            </li>
          {{/each}}
        </ol>
        <p class="op2-ajuda">{{localize "OP2.POI.DesafiosAjuda"}}</p>
      </fieldset>

      <label class="op2-campo op2-campo--inline">
        <span>{{localize "OP2.POI.LaboratorioDados"}}</span>
        <input type="number" name="system.laboratorioDados" value="{{sistema.laboratorioDados}}"
          min="4" max="6" step="1" {{#unless editavel}}disabled{{/unless}}>
      </label>
      <p class="op2-ajuda">{{localize "OP2.POI.LaboratorioDadosAjuda"}}</p>

      <label class="op2-campo op2-campo--inline">
        <input type="checkbox" name="system.reveladoPorLaser"
          {{#if sistema.reveladoPorLaser}}checked{{/if}} {{#unless editavel}}disabled{{/unless}}>
        <span>{{localize "OP2.POI.ReveladoPorLaser"}}</span>
      </label>
    </section>
  {{/if}}
</div>
