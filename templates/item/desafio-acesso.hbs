<div class="op2-item-ficha">
  <header class="op2-item-ficha__topo">
    <img src="{{item.img}}" alt="" data-action="editImage" data-edit="img">
    <input type="text" class="op2-nome" name="name" value="{{item.name}}" {{#unless editavel}}disabled{{/unless}}>
  </header>

  <fieldset class="op2-desafio-abordagens">
    <legend>{{localize "OP2.Desafio.Abordagens"}}</legend>
    <p class="op2-ajuda">{{localize "OP2.Desafio.AbordagensAjuda"}}</p>
    <div class="op2-desafio-abordagens__lista">
      <label class="op2-campo op2-campo--inline">
        <input type="checkbox" name="system.abordagens.arrombar" {{#if sistema.abordagens.arrombar}}checked{{/if}}
          {{#unless editavel}}disabled{{/unless}}>
        <span>{{localize "OP2.Desafio.Arrombar"}}</span>
      </label>
      <label class="op2-campo op2-campo--inline">
        <input type="checkbox" name="system.abordagens.destrancar" {{#if sistema.abordagens.destrancar}}checked{{/if}}
          {{#unless editavel}}disabled{{/unless}}>
        <span>{{localize "OP2.Desafio.Destrancar"}}</span>
      </label>
      <label class="op2-campo op2-campo--inline">
        <input type="checkbox" name="system.abordagens.hackTecnico" {{#if sistema.abordagens.hackTecnico}}checked{{/if}}
          {{#unless editavel}}disabled{{/unless}}>
        <span>{{localize "OP2.Desafio.HackTecnico"}}</span>
      </label>
      <label class="op2-campo op2-campo--inline">
        <input type="checkbox" name="system.abordagens.hackSocial" {{#if sistema.abordagens.hackSocial}}checked{{/if}}
          {{#unless editavel}}disabled{{/unless}}>
        <span>{{localize "OP2.Desafio.HackSocial"}}</span>
      </label>
    </div>
  </fieldset>

  <div class="op2-grade-campos">
    <label class="op2-campo">
      <span>{{localize "OP2.Desafio.DtObjeto"}}</span>
      <input type="number" name="system.dtObjeto" value="{{sistema.dtObjeto}}" min="0"
        {{#unless editavel}}disabled{{/unless}}>
    </label>

    <label class="op2-campo">
      <span>{{localize "OP2.Desafio.PontuacaoAlvo"}}</span>
      <input type="number" name="system.pontuacaoAlvo" value="{{sistema.pontuacaoAlvo}}" min="1"
        {{#unless editavel}}disabled{{/unless}}>
    </label>

    <label class="op2-campo">
      <span>{{localize "OP2.Desafio.MaxTentativas"}}</span>
      <input type="number" name="system.maxTentativas" value="{{sistema.maxTentativas}}" min="0"
        {{#unless editavel}}disabled{{/unless}}>
    </label>
  </div>
  <p class="op2-ajuda">{{localize "OP2.Desafio.MaxTentativasAjuda"}}</p>

  <fieldset class="op2-desafio-progresso">
    <legend>{{localize "OP2.Desafio.Progresso"}}</legend>

    <div class="op2-grade-campos">
      <label class="op2-campo">
        <span>{{localize "OP2.Desafio.PontuacaoAtual"}}</span>
        <span class="op2-stepper">
          <button type="button" class="op2-botao-icone" data-action="ajustarPontuacao" data-delta="-1"
            aria-label="{{localize 'OP2.Desafio.DiminuirPontuacao'}}" {{#unless editavel}}disabled{{/unless}}>
            <i class="fa-solid fa-minus" aria-hidden="true"></i>
          </button>
          <input type="number" name="system.pontuacaoAtual" value="{{sistema.pontuacaoAtual}}" min="0"
            {{#unless editavel}}disabled{{/unless}}>
          <button type="button" class="op2-botao-icone" data-action="ajustarPontuacao" data-delta="1"
            aria-label="{{localize 'OP2.Desafio.AumentarPontuacao'}}" {{#unless editavel}}disabled{{/unless}}>
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
        </span>
      </label>
      <label class="op2-campo">
        <span>{{localize "OP2.Desafio.TentativasUsadas"}}</span>
        <span class="op2-stepper">
          <button type="button" class="op2-botao-icone" data-action="ajustarTentativas" data-delta="-1"
            aria-label="{{localize 'OP2.Desafio.DiminuirTentativas'}}" {{#unless editavel}}disabled{{/unless}}>
            <i class="fa-solid fa-minus" aria-hidden="true"></i>
          </button>
          <input type="number" name="system.tentativasUsadas" value="{{sistema.tentativasUsadas}}" min="0"
            {{#unless editavel}}disabled{{/unless}}>
          <button type="button" class="op2-botao-icone" data-action="ajustarTentativas" data-delta="1"
            aria-label="{{localize 'OP2.Desafio.AumentarTentativas'}}" {{#unless editavel}}disabled{{/unless}}>
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
        </span>
      </label>
    </div>

    <div class="op2-progresso" role="progressbar"
      aria-valuenow="{{sistema.pontuacaoAtual}}" aria-valuemin="0" aria-valuemax="{{sistema.pontuacaoAlvo}}">
      <div class="op2-progresso__preenchido" style="width: {{percentualProgresso}}%"></div>
    </div>

    <label class="op2-campo op2-campo--inline">
      <input type="checkbox" name="system.quebrado" {{#if sistema.quebrado}}checked{{/if}}
        {{#unless editavel}}disabled{{/unless}}>
      <span>{{localize "OP2.Desafio.Quebrado"}}</span>
    </label>
  </fieldset>

  <fieldset class="op2-desafio-hack">
    <legend>{{localize "OP2.Desafio.Hackear"}}</legend>

    <div class="op2-desafio-hack__modo">
      <h4>{{localize "OP2.Desafio.HackTecnico"}}</h4>
      <label class="op2-campo op2-campo--inline">
        <input type="checkbox" name="system.hackTecnico.resolvido" {{#if sistema.hackTecnico.resolvido}}checked{{/if}}
          {{#unless editavel}}disabled{{/unless}}>
        <span>{{localize "OP2.Desafio.HackSucesso"}}</span>
      </label>
      {{#if editavel}}
        <div class="op2-desafio-hack__timer">
          <button type="button" class="op2-botao op2-botao--pequeno" data-action="iniciarTimerHack">
            {{localize "OP2.Desafio.HackTimerIniciar"}}
          </button>
          <span class="op2-desafio-hack__timer-valor" data-timer-hack></span>
        </div>
        <p class="op2-ajuda">{{localize "OP2.Desafio.HackTimerAjuda"}}</p>
      {{/if}}
    </div>

    <div class="op2-desafio-hack__modo">
      <h4>{{localize "OP2.Desafio.HackSocial"}}</h4>
      <label class="op2-campo op2-campo--inline">
        <input type="checkbox" name="system.hackSocial.resolvido" {{#if sistema.hackSocial.resolvido}}checked{{/if}}
          {{#unless editavel}}disabled{{/unless}}>
        <span>{{localize "OP2.Desafio.HackSucesso"}}</span>
      </label>
      <label class="op2-campo">
        <span>{{localize "OP2.Desafio.HackRespostasNecessarias"}}</span>
        <input type="number" name="system.hackSocial.respostasNecessarias" value="{{sistema.hackSocial.respostasNecessarias}}"
          min="1" {{#unless editavel}}disabled{{/unless}}>
      </label>

      <div class="op2-desafio-hack__perguntas">
        <span class="op2-ajuda">{{localize "OP2.Desafio.HackPerguntas"}}</span>
        {{#each perguntasHack}}
          <div class="op2-desafio-hack__pergunta">
            <input type="text" name="system.hackSocial.perguntas.{{indice}}.pergunta" value="{{pergunta}}"
              placeholder="{{localize 'OP2.Desafio.HackPergunta'}}" {{#unless @root.editavel}}disabled{{/unless}}>
            <input type="text" name="system.hackSocial.perguntas.{{indice}}.resposta" value="{{resposta}}"
              placeholder="{{localize 'OP2.Desafio.HackResposta'}}" {{#unless @root.editavel}}disabled{{/unless}}>
            {{#if @root.editavel}}
              <button type="button" class="op2-botao-icone" data-action="removerPerguntaHack" data-indice="{{indice}}"
                aria-label="{{localize 'OP2.Desafio.HackRemoverPergunta'}}">
                <i class="fa-solid fa-trash" aria-hidden="true"></i>
              </button>
            {{/if}}
          </div>
        {{/each}}
        {{#if editavel}}
          <button type="button" class="op2-botao op2-botao--pequeno" data-action="adicionarPerguntaHack">
            <i class="fa-solid fa-plus" aria-hidden="true"></i> {{localize "OP2.Desafio.HackAdicionarPergunta"}}
          </button>
        {{/if}}
      </div>
    </div>
  </fieldset>
</div>
