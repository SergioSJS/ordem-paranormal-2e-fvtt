{{!-- Rolagem de dano avulsa (sobrecarga mental, acidente da falha crítica): os dados
      como ícones, o total e onde cai. --}}
<div class="op2 op2-card op2-card--{{#if semDano}}sucesso{{else}}falha{{/if}}">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{titulo}}</span>
    <span class="op2-card__dt">{{formula}}</span>
  </header>

  {{#unless fixo}}
    <div class="op2-card__dados">
      {{#each dados}}
        <span class="op2-card__dado{{#unless contado}} descartado{{/unless}}" data-tooltip="{{dado}}">{{op2DadoResultado this}}</span>
      {{/each}}
      <span class="op2-card__igual" aria-hidden="true">=</span>
      <span class="op2-card__total">{{total}}</span>
    </div>
  {{/unless}}

  {{#if semDano}}
    <p class="op2-card__desfecho op2-card__desfecho--sucesso">
      <i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "OP2.Rodada.SemDanoRolado"}}
    </p>
  {{else}}
    <p class="op2-card__desfecho op2-card__desfecho--falha">
      <i class="fa-solid fa-heart-crack" aria-hidden="true"></i>
      {{localize "OP2.Rodada.DanoAplicado" total=total recurso=recurso}}
    </p>
  {{/if}}
</div>
