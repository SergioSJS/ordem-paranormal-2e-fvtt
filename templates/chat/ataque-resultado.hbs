<div class="op2 op2-card op2-card--investigacao">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{titulo}}</span>
    <span class="op2-card__dt">{{totalAtaque}} × {{totalDefesa}}</span>
  </header>

  <p class="op2-card__texto">{{texto}}</p>

  {{#if temDano}}
    <div class="op2-card__acoes">
      <button type="button" class="op2-botao op2-botao--pequeno op2-botao--perigo"
        data-op2-acao="aplicar-dano-alvo" data-ator-id="{{quemSofreId}}"
        data-quantidade="{{dano}}" data-recurso="pv">
        {{localize "OP2.Combate.AplicarDano" nome=quemSofreNome dano=dano}}
      </button>
    </div>
  {{/if}}
</div>
