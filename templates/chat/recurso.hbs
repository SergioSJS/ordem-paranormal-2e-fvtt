<div class="op2 op2-card op2-card--investigacao">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{titulo}}</span>
    <span class="op2-card__dt">{{itemNome}}</span>
  </header>

  <p class="op2-card__texto">{{texto}}</p>
  {{#if descricao}}<div class="op2-card__texto">{{{descricao}}}</div>{{/if}}

  {{!-- Quem decide o efeito é o mestre (spec §6.6): o botão é dele, e some da
        tela do jogador junto com o resto do conteúdo de mestre. --}}
  <div class="op2-card__acoes" data-op2-gm>
    <button type="button" class="op2-botao op2-botao--pequeno" data-op2-acao="conceder-passo"
      data-ator-id="{{atorId}}" data-passos="1" data-origem="{{itemNome}}">
      {{rotuloConceder}}
    </button>
  </div>
</div>
