<div class="op2 op2-card op2-card--{{#if sucesso}}sucesso{{else}}falha{{/if}}">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{titulo}}</span>
  </header>

  <div class="op2-card__dados">
    {{#each sequencia}}
      <span class="op2-card__dado{{#unless contado}} descartado{{/unless}}">{{op2DadoResultado this}}</span>
    {{/each}}
  </div>

  {{#if sucesso}}
    <p class="op2-card__desfecho op2-card__desfecho--sucesso">
      <i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "OP2.Ferramenta.LaboratorioValido"}}
    </p>
    {{#if resultadoPoi}}
      <div class="op2-card__texto">{{{resultadoPoi}}}</div>
    {{/if}}
  {{else}}
    <p class="op2-card__desfecho op2-card__desfecho--falha">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "OP2.Ferramenta.LaboratorioQuebrou"}}
    </p>
  {{/if}}
</div>
