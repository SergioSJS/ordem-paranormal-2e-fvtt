<div class="op2 op2-card op2-card--investigacao">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{titulo}}</span>
  </header>

  <p class="op2-card__texto">{{texto}}</p>

  <div class="op2-card__acoes">
    {{#if botaoAliado}}
      <button type="button" class="op2-botao op2-botao--pequeno" data-op2-acao="testar-compartilhar"
        data-ator-id="{{botaoAliado.atorId}}" data-compartilhador-id="{{botaoAliado.compartilhadorId}}">
        {{botaoAliado.rotulo}}
      </button>
    {{/if}}
    {{#if acaoGM}}
      <button type="button" class="op2-botao op2-botao--pequeno" data-op2-gm
        data-op2-acao="{{acaoGM}}" data-ator-id="{{atorId}}">{{rotuloGM}}</button>
    {{/if}}
  </div>
</div>
