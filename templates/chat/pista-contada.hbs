{{!-- Um jogador contou ao grupo uma pista que o personagem dele achou: card público, sem sussurro. --}}
<div class="op2 op2-card op2-card--investigacao">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena"><i class="fa-solid fa-bullhorn" aria-hidden="true"></i> {{titulo}}</span>
    <span class="op2-card__dt">{{poiNome}}</span>
  </header>
  <ol class="op2-card__infos">
    <li class="op2-card__info">
      <span class="op2-card__info-pericia">{{rotuloPericia}}:</span> {{{texto}}}
    </li>
  </ol>
  <div class="op2-card__texto">{{localize "OP2.Investigacao.ContadaVisivel"}}</div>
</div>
