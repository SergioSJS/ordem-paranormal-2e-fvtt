<div class="op2 op2-card op2-card--{{#if conseguiu}}sucesso{{else}}{{#if quebrado}}falha{{else}}investigacao{{/if}}{{/if}}">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{titulo}}</span>
    <span class="op2-card__dt">{{desafioNome}}</span>
  </header>

  {{#if conseguiu}}
    <p class="op2-card__desfecho op2-card__desfecho--sucesso">
      <i class="fa-solid fa-lock-open" aria-hidden="true"></i> {{localize "OP2.Desafio.Arrombou"}}
    </p>
  {{else if quebrado}}
    <p class="op2-card__desfecho op2-card__desfecho--falha">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{localize "OP2.Desafio.Quebrou"}}
    </p>
  {{else}}
    <p class="op2-ajuda">
      {{localize "OP2.Desafio.Progresso"}}: {{pontuacaoAtual}} / {{pontuacaoAlvo}}
      {{#unless sucesso}} — {{localize "OP2.Falha"}}{{/unless}}
    </p>
  {{/if}}
</div>
