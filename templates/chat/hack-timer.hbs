{{!-- Card público do problema do hack técnico: o que foi revelado e, depois, o
      veredito do mestre. Os botões de veredito aqui são o plano B se a janela do
      contador fechou. --}}
<div class="op2 op2-card op2-card--{{#if (op2Eq fase "fim")}}{{#if acertou}}sucesso{{else}}falha{{/if}}{{else}}investigacao{{/if}}">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{localize "OP2.Desafio.HackTecnico"}}</span>
    <span class="op2-card__dt">{{desafioNome}}</span>
  </header>

  {{#if (op2Eq fase "inicio")}}
    <p class="op2-card__desfecho">
      <i class="fa-solid fa-stopwatch" aria-hidden="true"></i>
      {{localize "OP2.Desafio.HackProblemaTitulo" segundos=segundos}}
    </p>
    {{#if pergunta}}
      <p class="op2-card__infos op2-card__pergunta"><strong>{{pergunta}}</strong></p>
    {{else}}
      <p class="op2-ajuda">{{localize "OP2.Desafio.HackProblemaOral"}}</p>
    {{/if}}
    <div class="op2-card__acoes">
      <button type="button" class="op2-botao op2-botao--pequeno" data-op2-gm
        data-op2-acao="hack-tecnico-acertou" data-ator-id="{{atorId}}" data-desafio-uuid="{{desafioUuid}}">
        <i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "OP2.Desafio.HackAcertou"}}
      </button>
      <button type="button" class="op2-botao op2-botao--pequeno op2-botao--perigo" data-op2-gm
        data-op2-acao="hack-tecnico-errou" data-ator-id="{{atorId}}" data-desafio-uuid="{{desafioUuid}}">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "OP2.Desafio.HackErrou"}}
      </button>
    </div>
  {{else}}
    {{#if acertou}}
      <p class="op2-card__desfecho op2-card__desfecho--sucesso">
        <i class="fa-solid fa-unlock" aria-hidden="true"></i> {{localize "OP2.Desafio.HackAcertouTexto" ator=atorNome}}
      </p>
    {{else}}
      <p class="op2-card__desfecho op2-card__desfecho--falha">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "OP2.Desafio.HackErrouTexto" ator=atorNome}}
      </p>
    {{/if}}
  {{/if}}
</div>
