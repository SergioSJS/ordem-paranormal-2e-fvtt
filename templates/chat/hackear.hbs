{{!-- Dois cards por hack: o do jogador e o do mestre (`soMestre`, criado no cliente
      do mestre). Hack técnico com tabela: o jogador só sabe o total e que o mestre
      prepara; o mestre recebe faixa, conta, resposta, segundos e o botão de revelar. --}}
<div class="op2 op2-card op2-card--{{#if aguardaMestre}}investigacao{{else if sucesso}}sucesso{{else}}falha{{/if}}{{#if soMestre}} op2-card--mestre{{/if}}">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{titulo}}</span>
    <span class="op2-card__dt">{{desafioNome}}</span>
  </header>

  {{!-- Os dados vivem no card da própria ação: o card genérico de teste saía público
        e ainda oferecia "Dano RA/RB", que não existe aqui (achado em uso real). --}}
  {{#unless soMestre}}
    {{#if componentes}}
      <div class="op2-card__dados">
        {{#each componentes}}
          <span class="op2-card__dado{{#unless contado}} descartado{{/unless}}"
            data-tooltip="{{componente.rotulo}}">{{op2DadoResultado this}}</span>
        {{/each}}
        <span class="op2-card__igual" aria-hidden="true">=</span>
        <span class="op2-card__total">{{total}}</span>
        {{#if dt}}<span class="op2-card__dt">DT {{dt}}</span>{{/if}}
      </div>
    {{/if}}
    {{#if falhaCritica}}
      {{> (op2Caminho "partials/falha-critica") atorId=atorId}}
    {{/if}}
  {{/unless}}

  {{#if soMestre}}
    <p class="op2-card__so-mestre">
      <i class="fa-solid fa-user-secret" aria-hidden="true"></i> {{localize "OP2.Chat.SoMestre"}}
    </p>
    {{#if tecnico}}
      {{#if comTabela}}
        <p class="op2-card__texto">{{localize "OP2.Desafio.HackMestrePreparar" total=total faixa=faixa segundos=segundos}}</p>
        <p class="op2-card__infos"><strong>{{problema}}</strong></p>
        <div class="op2-card__acoes">
          <button type="button" class="op2-botao op2-botao--pequeno" data-op2-gm
            data-op2-acao="iniciar-hack-tecnico" data-ator-id="{{atorId}}" data-desafio-uuid="{{desafioUuid}}"
            data-faixa="{{indiceFaixa}}">
            <i class="fa-solid fa-play" aria-hidden="true"></i> {{localize "OP2.Desafio.HackIniciar"}}
          </button>
        </div>
      {{else}}
        <p class="op2-ajuda">{{localize "OP2.Desafio.HackTecnicoAjudaMestre"}}</p>
        <div class="op2-card__acoes">
          <button type="button" class="op2-botao op2-botao--pequeno" data-op2-gm
            data-op2-acao="iniciar-hack-tecnico" data-ator-id="{{atorId}}" data-desafio-uuid="{{desafioUuid}}" data-faixa="-1">
            <i class="fa-solid fa-play" aria-hidden="true"></i> {{localize "OP2.Desafio.HackIniciar"}}
          </button>
          <button type="button" class="op2-botao op2-botao--pequeno" data-op2-gm
            data-op2-acao="marcar-hack-tecnico-resolvido" data-ator-id="{{atorId}}" data-desafio-uuid="{{desafioUuid}}">
            {{localize "OP2.Desafio.HackMarcarResolvido"}}
          </button>
        </div>
      {{/if}}
    {{/if}}
    {{#if social}}
      <p class="op2-ajuda">
        {{localize "OP2.Desafio.HackSocialChances" chances=chancesDeErro necessarias=respostasNecessarias}}
      </p>
      {{#if perguntas.length}}
        <ul class="op2-card__infos">
          {{#each perguntas}}
            <li>{{pergunta}} — <strong>{{resposta}}</strong></li>
          {{/each}}
        </ul>
      {{/if}}
      <button type="button" class="op2-botao op2-botao--pequeno" data-op2-gm
        data-op2-acao="marcar-hack-social-resolvido" data-ator-id="{{atorId}}" data-desafio-uuid="{{desafioUuid}}">
        {{localize "OP2.Desafio.HackMarcarResolvido"}}
      </button>
    {{/if}}
  {{else if aguardaMestre}}
    <p class="op2-card__desfecho">
      <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
      {{localize "OP2.Desafio.HackAguardaMestre" total=total}}
    </p>
  {{else}}
    {{#if sucesso}}
      <p class="op2-card__desfecho op2-card__desfecho--sucesso">
        <i class="fa-solid fa-unlock" aria-hidden="true"></i> {{localize "OP2.Desafio.HackSucesso"}}
      </p>
    {{else}}
      <p class="op2-card__desfecho op2-card__desfecho--falha">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{localize "OP2.Desafio.HackFalha"}}
      </p>
      {{#if semResposta}}
        <p class="op2-ajuda">{{localize "OP2.Desafio.HackTecnicoSemFaixa"}}</p>
      {{else}}
        <p class="op2-ajuda">{{localize "OP2.Desafio.HackEsperaRodada"}}</p>
      {{/if}}
    {{/if}}
  {{/if}}
</div>
