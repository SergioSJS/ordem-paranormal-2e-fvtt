<div class="op2 op2-card op2-card--{{#if sucesso}}sucesso{{else}}falha{{/if}}">
  <header class="op2-card__topo">
    <span class="op2-tag op2-tag--pequena">{{titulo}}</span>
    <span class="op2-card__dt">{{modo}}</span>
  </header>

  {{#if sucesso}}
    <p class="op2-card__desfecho op2-card__desfecho--sucesso">
      <i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "OP2.Desafio.Alcancou"}}
    </p>
  {{else}}
    <p class="op2-card__desfecho op2-card__desfecho--falha">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "OP2.Desafio.AlcancarFalhou"}}
    </p>
    <div class="op2-card__acoes">
      <button type="button" class="op2-botao op2-botao--pequeno" data-op2-acao="aplicar-dano"
        data-quantidade="{{dano}}" data-recurso="pv" data-ator-id="{{atorId}}">
        {{localize "OP2.Chat.AplicarDano"}} ({{dano}})
      </button>
    </div>
  {{/if}}
</div>
